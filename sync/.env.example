# Copy this file to .env and edit it:   cp .env.example .env
# Every setting except the domain is optional: remove the # in front of a line to use it.

# Required. The DNS name that points at this machine (no https://, no slash).
# Ports 80 and 443 must be reachable from the internet so Caddy can get the certificate.
AMBY_SYNC_DOMAIN=sync.example.org

# Which server version to run. Default: latest.
# Pin a number (see the package list on GitHub) so updates happen only when you choose.
# AMBY_SYNC_VERSION=0.2.0

# --- Accounts ---------------------------------------------------------------------------------

# 1 lets people create an account from the app without an invitation code. Default: 0 (only
# accounts you add with `user add`). Attempts are limited per address.
# AMBY_SYNC_OPEN_REGISTRATION=1

# With open registration: how many accounts may exist at most. Default: no limit.
# AMBY_SYNC_MAX_USERS=50

# --- Space on disk ----------------------------------------------------------------------------

# The largest encrypted file. 30416160 matches the 30 MB file limit of the app (recommended).
# Default: 536870912 (512 MiB).
# AMBY_SYNC_MAX_BLOB_BYTES=30416160

# Most encrypted bytes one user may keep (current files and unfinished uploads; history apart).
# Default: no limit. Plans (plans.json) can set this per user, see README.
# AMBY_SYNC_QUOTA_BYTES_PER_USER=5368709120

# Free space the server always keeps on its disk. Below it, new uploads and new accounts are
# refused; reading and deleting still work. 0 turns the check off. Default: 1073741824 (1 GiB).
# AMBY_SYNC_MIN_FREE_BYTES=2147483648

# Days to keep replaced and deleted versions. Default: 30.
# AMBY_SYNC_RETAIN_VERSION_DAYS=30

# --- Load -------------------------------------------------------------------------------------

# Requests larger than 1 MiB the server reads at the same time; more get "busy, try later".
# Default: 4.
# AMBY_SYNC_MAX_LARGE_BODIES=4
