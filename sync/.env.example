# Copy this file to .env and edit it:   cp .env.example .env

# Required. The DNS name that points at this machine (no https://, no slash).
# Ports 80 and 443 must be reachable from the internet so Caddy can get the certificate.
AMBY_SYNC_DOMAIN=sync.example.org

# Optional. Which server version to run. Default: latest.
# Pin a number (see the package list on GitHub) so updates happen only when you choose.
# AMBY_SYNC_VERSION=0.1.0

# Optional. Most encrypted bytes one user may keep (here 5 GiB). Default: no limit.
# AMBY_SYNC_QUOTA_BYTES_PER_USER=5368709120
